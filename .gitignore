# Data and logs stay on the server; checksums and versions are tracked in config/datasets.yaml
data/**
!data/**/
!data/**/.gitkeep
!data/raw/checksums.sha256
logs/
*.gz
.Rhistory
.RData
__pycache__/
omnipathr-log/
.ARACNe3_cached/

# editing backups: git history is the record
*.bak-pre-*

# D128 sandbox: large per-row tables and the reachability cache stay on the server
results/lincs/d128/**/*.parquet
results/lincs/d128/**/cache/

# systems_validation: CARNIVAL LP/solver intermediates (regenerable, >100MB)
results/systems_validation/**/work/
logs/runs/
